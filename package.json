{
  "name": "orchestrator",
  "private": true,
  "version": "0.1.0",
  "description": "A Tauri 2, React, TypeScript, and SQLite desktop app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "generate:bindings": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --no-default-features --bin generate-bindings -- src/generated/tauri.ts",
    "check:bindings": "node scripts/check-generated-bindings.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "tsc --noEmit && npm run check:architecture && npm run check:bindings",
    "build:tauri": "npm run prepare:native-runtimes && npm run build",
    "prepare:native-runtimes": "npm run prepare:github-cli-runtime && npm run prepare:codex-engine",
    "prepare:codex-engine": "node scripts/prepare-codex-engine.mjs",
    "prepare:github-cli-runtime": "node scripts/prepare-github-cli-runtime.mjs",
    "test": "vitest run",
    "test:native-approval": "node scripts/native-approval-smoke.mjs",
    "test:github-cli-runtime": "npm run prepare:github-cli-runtime && node scripts/test-github-cli-runtime.mjs",
    "test:live-goal-environment": "RUN_CODEX_LIVE_GOAL_ENVIRONMENT_TEST=1 node scripts/live-native-goal-environment.mjs",
    "test:live-plan": "RUN_CODEX_LIVE_PLAN_TEST=1 node scripts/live-native-plan-mode.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-virtual": "^3.14.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.10",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^27.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.6"
  }
}
