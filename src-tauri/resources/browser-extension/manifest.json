{
  "manifest_version": 3,
  "name": "Orchestrator Browser Bridge",
  "version": "0.1.0",
  "description": "Lets Orchestrator test approved tabs in your default Chromium browser.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Orchestrator Browser Bridge",
    "default_popup": "status.html"
  }
}
